# Copy to .env and adjust before running `docker compose up`.

# Postgres
POSTGRES_DB=edutrack
POSTGRES_USER=edutrack
POSTGRES_PASSWORD=edutrack

# Backend
ASPNETCORE_ENVIRONMENT=Production
# Generate a long random string for production, e.g.: openssl rand -base64 48
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ISSUER=EduTrack
JWT_AUDIENCE=EduTrackClient

# Public origin the app is served from (used for the backend's CORS allow-list)
APP_ORIGIN=http://localhost:8080

# Port Nginx publishes on the host — the whole app (frontend + API + Swagger) is reachable here
APP_PORT=8080

# RustFS (S3-compatible object storage for assignment/submission file uploads)
# Generate a long random string for production, e.g.: openssl rand -base64 48
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
RUSTFS_BUCKET_NAME=edutrack-uploads
# Host ports for RustFS's S3 API and web console (only needed if you want to reach them directly,
# e.g. to browse the console at http://localhost:9001 — the backend always talks to RustFS over
# the internal Docker network regardless of these)
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
