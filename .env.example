# Copy to .env and adjust before running `docker compose up`.

# Postgres
POSTGRES_DB=edutrack
POSTGRES_USER=edutrack
POSTGRES_PASSWORD=edutrack

# Backend
ASPNETCORE_ENVIRONMENT=Production
# Generate a long random string for production, e.g.: openssl rand -base64 48
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ISSUER=EduTrack
JWT_AUDIENCE=EduTrackClient

# Public origin the app is served from (used for the backend's CORS allow-list)
APP_ORIGIN=http://localhost:8080

# Port Nginx publishes on the host — the whole app (frontend + API + Swagger) is reachable here
APP_PORT=8080
